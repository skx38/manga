// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  // Public handle. Auto-derived from email/provider on first OAuth sign-in if missing.
  username  String?  @unique
  email     String?  @unique
  emailVerified DateTime?
  name      String?
  // Bcrypt hash for credentials login. Null for OAuth-only accounts.
  passwordHash String?

  settings  Json?    // Reader preferences

  // Profile & Social
  image                String?
  bannerImage          String?
  bio                  String?

  // Gamification
  level                Int       @default(1)
  xp                   Int       @default(0)
  streakDays           Int       @default(0)
  freezeTokens         Int       @default(0)
  lastReadDate         DateTime?

  // Karma (recomputed nightly by /api/cron/recompute-karma)
  postKarma            Int       @default(0)
  commentKarma         Int       @default(0)

  // Settings
  preferences          Json?     // Global app preferences
  privacySettings      Json?
  notificationSettings Json?
  favoriteGenres       Json?     // Onboarding data

  createdAt DateTime @default(now())

  // NextAuth relations
  accounts  Account[]
  sessions  Session[]

  readingProgress   ReadingProgress[]
  comments          Comment[]
  posts             Post[]
  votes             Vote[]
  subscriptions     Subscription[]
  folders           Folder[]
  reviews           Review[]
  readingStats      UserReadingStat[]
  libraryEntries    LibraryEntry[]
  reviewReactions   ReviewReaction[]
  savedItems        SavedItem[]
  notifications     Notification[]    @relation("NotificationRecipient")
  actorNotifications Notification[]   @relation("NotificationActor")
  reportsFiled      Report[]          @relation("ReportReporter")
  reportsResolved   Report[]          @relation("ReportResolver")
  modOf             ComicMod[]
}

// --- NextAuth tables ----------------------------------------------------
// Schema follows the official Prisma adapter shape:
// https://authjs.dev/reference/adapter/prisma

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum Origin {
  JP
  KR
  CN
}

enum Status {
  ONGOING
  COMPLETED
  HIATUS
  CANCELLED
}

enum ContentRating {
  SAFE
  SUGGESTIVE
  EROTICA
}

model Comic {
  id            String   @id @default(uuid())
  title         String
  altTitles     Json?    // Alternative titles in different languages
  type          String   // Webtoon/Manga
  status        Status   @default(ONGOING)
  origin        Origin
  description   String?
  coverImageUrl String?
  slug          String   @unique
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  // New Metadata Fields
  publishedYear Int?
  publishedAt   DateTime? // Precise release date
  demographic   String?
  contentRating ContentRating @default(SAFE)
  chapterCount  Int      @default(0) // Cached count for filtering
  views         Int      @default(0) // For Popular sort
  authors       Json?    // Array of strings
  artists       Json?    // Array of strings
  publishers    Json?    // Array of strings
  rating        Float    @default(0)
  
  chapters      Chapter[]
  tags          ComicTag[]
  folders       FolderComic[]
  reviews       Review[]
  libraryEntries LibraryEntry[]
  posts         Post[]
  communityRules Json?
  bannedWords   String[]      @default([])
  mods          ComicMod[]
}

enum PageMode {
  STRIP    // Vertical scroll (Webtoon)
  PAGE     // Horizontal pages (Manga)
}

enum PostKind {
  USER
  CHAPTER_DISCUSSION
}

model Chapter {
  id          String   @id @default(uuid())
  comicId     String
  number      Float
  title       String
  slug        String
  releaseDate DateTime
  pageMode    PageMode @default(STRIP)
  likes       Int      @default(0)
  magnet      String?
  
  comic       Comic    @relation(fields: [comicId], references: [id])
  pages       Page[]
  comments    Comment[]
  progress    ReadingProgress[]
  discussion  Post?

  @@unique([comicId, slug])
}

model Page {
  id        String @id @default(uuid())
  chapterId String
  orderIndex Int
  imageUrl  String
  width     Int
  height    Int
  
  chapter   Chapter @relation(fields: [chapterId], references: [id])
}

model ReadingProgress {
  userId           String
  chapterId        String
  pageNumber       Int
  scrollPercentage Float
  lastRead         DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id])
  chapter Chapter @relation(fields: [chapterId], references: [id])

  @@id([userId, chapterId])
}

// Bullet comments overlaid on a page in the reader (Niconico-style).
// pageIndex: 0-based page within the chapter.
// trackY: 0-1 vertical position chosen client-side to avoid overlaps.
model DanmuComment {
  id         String   @id @default(uuid())
  chapterId  String
  pageIndex  Int
  text       String   @db.VarChar(120)
  trackY     Float    @default(0.1)
  color      String?  // hex like #fff; null = default
  userId     String
  createdAt  DateTime @default(now())

  @@index([chapterId, pageIndex])
}

model Tag {
  id   Int    @id @default(autoincrement())
  name String @unique
  type String // Demographic/Theme
  
  comics ComicTag[]
}

model ComicTag {
  comicId String
  tagId   Int
  
  comic Comic @relation(fields: [comicId], references: [id])
  tag   Tag   @relation(fields: [tagId], references: [id])
  
  @@id([comicId, tagId])
}

model Post {
  id        String   @id @default(uuid())
  kind      PostKind @default(USER)
  title     String
  content   String?
  flair     String?  // e.g. "Theory", "Art", "Discussion"
  comicId   String
  userId    String
  // For CHAPTER_DISCUSSION posts only — links back to the chapter that spawned this thread.
  chapterId String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  editedAt  DateTime?

  // Mod / lifecycle flags
  isDeleted Boolean  @default(false)  // author soft-deleted
  isLocked  Boolean  @default(false)  // mod-locked, no new comments
  isPinned  Boolean  @default(false)  // pinned to top of comic feed
  isRemoved Boolean  @default(false)  // mod-removed, hidden from feed

  comic    Comic         @relation(fields: [comicId], references: [id], onDelete: Cascade)
  user     User          @relation(fields: [userId], references: [id])
  chapter  Chapter?      @relation(fields: [chapterId], references: [id])
  comments Comment[]
  votes    Vote[]
  savedBy  SavedItem[]
  notifications Notification[]
  reports  Report[]

  @@index([comicId, createdAt])
  @@index([userId])
}

model Vote {
  id        String   @id @default(uuid())
  userId    String
  value     Int      // 1 for upvote, -1 for downvote
  postId    String?
  commentId String?
  createdAt DateTime @default(now())

  user    User     @relation(fields: [userId], references: [id])
  post    Post?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  comment Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@unique([userId, commentId])
  @@index([postId])
  @@index([commentId])
}

model Comment {
  id        String   @id @default(uuid())
  content   String
  userId    String
  chapterId String?
  postId    String?  // For community posts
  parentId  String?  // For nested replies
  isSpoiler Boolean  @default(false)
  isDeleted Boolean  @default(false)
  isEdited  Boolean  @default(false)
  editedAt  DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User           @relation(fields: [userId], references: [id])
  chapter   Chapter?       @relation(fields: [chapterId], references: [id])
  post      Post?          @relation(fields: [postId], references: [id])
  parent    Comment?       @relation("CommentReplies", fields: [parentId], references: [id])
  replies   Comment[]      @relation("CommentReplies")
  votes     Vote[]
  savedBy   SavedItem[]
  notifications Notification[]
  reports   Report[]

  @@index([postId, parentId])
  @@index([userId])
}

model Subscription {
  id        String   @id @default(uuid())
  userId    String
  plan      String
  startDate DateTime
  endDate   DateTime
  
  user User @relation(fields: [userId], references: [id])
}

model Folder {
  id        String   @id @default(uuid())
  userId    String
  name      String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  
  // Sharing
  isPublic  Boolean  @default(false)
  shareId   String?  @unique @default(uuid())
  
  user   User          @relation(fields: [userId], references: [id])
  comics FolderComic[]
  
  @@unique([userId, name])
}

model FolderComic {
  folderId String
  comicId  String
  addedAt  DateTime @default(now())
  
  folder Folder @relation(fields: [folderId], references: [id], onDelete: Cascade)
  comic  Comic  @relation(fields: [comicId], references: [id], onDelete: Cascade)
  
  @@id([folderId, comicId])
}

model Review {
  id        String   @id @default(uuid())
  userId    String
  comicId   String
  recommend Boolean  // Steam-style: thumbs up or down
  comment   String?  // Optional text review
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  user  User  @relation(fields: [userId], references: [id])
  comic Comic @relation(fields: [comicId], references: [id], onDelete: Cascade)
  reactions ReviewReaction[]
  
  @@unique([userId, comicId])
}

model ReviewReaction {
  id        String   @id @default(uuid())
  userId    String
  reviewId  String
  type      String   // "HELPFUL", "FUNNY", "👍", etc.
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id])
  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@unique([userId, reviewId, type])
}

model UserReadingStat {
  id           String   @id @default(uuid())
  userId       String
  date         DateTime @db.Date
  chaptersRead Int      @default(0)
  
  user User @relation(fields: [userId], references: [id])
  
  @@unique([userId, date])
}

enum LibraryStatus {
  READING
  COMPLETED
  ON_HOLD
  DROPPED
  PLAN_TO_READ
}

model LibraryEntry {
  userId     String
  comicId    String
  status     LibraryStatus
  score      Float?
  startedAt  DateTime?
  finishedAt DateTime?
  updatedAt  DateTime      @updatedAt
  
  user  User  @relation(fields: [userId], references: [id])
  comic Comic @relation(fields: [comicId], references: [id], onDelete: Cascade)

  @@id([userId, comicId])
}

model SavedItem {
  id        String   @id @default(uuid())
  userId    String
  postId    String?
  commentId String?
  createdAt DateTime @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post    Post?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  comment Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@unique([userId, commentId])
  @@index([userId])
}

enum NotificationType {
  REPLY
  MENTION
  MOD_ACTION
}

model Notification {
  id          String           @id @default(uuid())
  userId      String           // recipient
  type        NotificationType
  actorId     String?          // who triggered it
  postId      String?
  commentId   String?
  readAt      DateTime?
  createdAt   DateTime         @default(now())

  user    User     @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  actor   User?    @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)
  post    Post?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  comment Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
}

enum ModRole {
  MOD
  ADMIN
}

model ComicMod {
  comicId   String
  userId    String
  role      ModRole  @default(MOD)
  createdAt DateTime @default(now())

  comic Comic @relation(fields: [comicId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([comicId, userId])
  @@index([userId])
}

enum ReportReason {
  SPAM
  HARASSMENT
  NSFW
  SPOILER
  OTHER
}

enum ReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

model Report {
  id           String       @id @default(uuid())
  reporterId   String
  postId       String?
  commentId    String?
  reason       ReportReason
  details      String?
  status       ReportStatus @default(OPEN)
  resolvedById String?
  createdAt    DateTime     @default(now())
  resolvedAt   DateTime?

  reporter   User     @relation("ReportReporter", fields: [reporterId], references: [id])
  resolvedBy User?    @relation("ReportResolver", fields: [resolvedById], references: [id])
  post       Post?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  comment    Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([postId])
  @@index([commentId])
}
