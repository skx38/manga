// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  username  String   @unique
  email     String   @unique
  settings  Json?    // Reader preferences
  
  // Profile & Social
  image                String?
  bannerImage          String?
  bio                  String?
  
  // Gamification
  level                Int       @default(1)
  xp                   Int       @default(0)
  
  // Settings
  preferences          Json?     // Global app preferences
  privacySettings      Json?
  notificationSettings Json?
  favoriteGenres       Json?     // Onboarding data

  createdAt DateTime @default(now())
  
  readingProgress ReadingProgress[]
  comments        Comment[]
  posts           Post[]
  votes           Vote[]
  subscriptions   Subscription[]
  folders         Folder[]
  reviews         Review[]
  readingStats    UserReadingStat[]
  libraryEntries  LibraryEntry[]
  reviewReactions ReviewReaction[]
}

enum Origin {
  JP
  KR
  CN
}

enum Status {
  ONGOING
  COMPLETED
  HIATUS
  CANCELLED
}

enum ContentRating {
  SAFE
  SUGGESTIVE
  EROTICA
}

model Comic {
  id            String   @id @default(uuid())
  title         String
  altTitles     Json?    // Alternative titles in different languages
  type          String   // Webtoon/Manga
  status        Status   @default(ONGOING)
  origin        Origin
  description   String?
  coverImageUrl String?
  slug          String   @unique
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  // New Metadata Fields
  publishedYear Int?
  publishedAt   DateTime? // Precise release date
  demographic   String?
  contentRating ContentRating @default(SAFE)
  chapterCount  Int      @default(0) // Cached count for filtering
  views         Int      @default(0) // For Popular sort
  authors       Json?    // Array of strings
  artists       Json?    // Array of strings
  publishers    Json?    // Array of strings
  rating        Float    @default(0)
  
  chapters      Chapter[]
  tags          ComicTag[]
  folders       FolderComic[]
  reviews       Review[]
  libraryEntries LibraryEntry[]
  posts         Post[]
}

enum PageMode {
  STRIP    // Vertical scroll (Webtoon)
  PAGE     // Horizontal pages (Manga)
}

model Chapter {
  id          String   @id @default(uuid())
  comicId     String
  number      Float
  title       String
  slug        String
  releaseDate DateTime
  isLocked    Boolean  @default(false)
  pageMode    PageMode @default(STRIP)
  likes       Int      @default(0)
  
  comic       Comic    @relation(fields: [comicId], references: [id])
  pages       Page[]
  comments    Comment[]
  progress    ReadingProgress[]
  
  @@unique([comicId, slug])
}

model Page {
  id        String @id @default(uuid())
  chapterId String
  orderIndex Int
  imageUrl  String
  width     Int
  height    Int
  
  chapter   Chapter @relation(fields: [chapterId], references: [id])
}

model ReadingProgress {
  userId           String
  chapterId        String
  pageNumber       Int
  scrollPercentage Float
  lastRead         DateTime @default(now())
  
  user    User    @relation(fields: [userId], references: [id])
  chapter Chapter @relation(fields: [chapterId], references: [id])
  
  @@id([userId, chapterId])
}

model Tag {
  id   Int    @id @default(autoincrement())
  name String @unique
  type String // Demographic/Theme
  
  comics ComicTag[]
}

model ComicTag {
  comicId String
  tagId   Int
  
  comic Comic @relation(fields: [comicId], references: [id])
  tag   Tag   @relation(fields: [tagId], references: [id])
  
  @@id([comicId, tagId])
}

model Post {
  id        String   @id @default(uuid())
  title     String
  content   String?
  flair     String?  // e.g. "Theory", "Art", "Discussion"
  comicId   String
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  comic    Comic     @relation(fields: [comicId], references: [id], onDelete: Cascade)
  user     User      @relation(fields: [userId], references: [id])
  comments Comment[]
  votes    Vote[]
}

model Vote {
  id        String   @id @default(uuid())
  userId    String
  value     Int      // 1 for upvote, -1 for downvote
  postId    String?
  commentId String?
  createdAt DateTime @default(now())

  user    User     @relation(fields: [userId], references: [id])
  post    Post?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  comment Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@unique([userId, commentId])
}

model Comment {
  id        String   @id @default(uuid())
  content   String
  userId    String
  chapterId String?
  postId    String?  // For community posts
  parentId  String?  // For nested replies
  isSpoiler Boolean  @default(false)
  isDeleted Boolean  @default(false)
  isEdited  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id])
  chapter  Chapter?  @relation(fields: [chapterId], references: [id])
  post     Post?     @relation(fields: [postId], references: [id])
  parent   Comment?  @relation("CommentReplies", fields: [parentId], references: [id])
  replies  Comment[] @relation("CommentReplies")
  votes    Vote[]
}

model Subscription {
  id        String   @id @default(uuid())
  userId    String
  plan      String
  startDate DateTime
  endDate   DateTime
  
  user User @relation(fields: [userId], references: [id])
}

model Folder {
  id        String   @id @default(uuid())
  userId    String
  name      String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  
  // Sharing
  isPublic  Boolean  @default(false)
  shareId   String?  @unique @default(uuid())
  
  user   User          @relation(fields: [userId], references: [id])
  comics FolderComic[]
  
  @@unique([userId, name])
}

model FolderComic {
  folderId String
  comicId  String
  addedAt  DateTime @default(now())
  
  folder Folder @relation(fields: [folderId], references: [id], onDelete: Cascade)
  comic  Comic  @relation(fields: [comicId], references: [id], onDelete: Cascade)
  
  @@id([folderId, comicId])
}

model Review {
  id        String   @id @default(uuid())
  userId    String
  comicId   String
  recommend Boolean  // Steam-style: thumbs up or down
  comment   String?  // Optional text review
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  user  User  @relation(fields: [userId], references: [id])
  comic Comic @relation(fields: [comicId], references: [id], onDelete: Cascade)
  reactions ReviewReaction[]
  
  @@unique([userId, comicId])
}

model ReviewReaction {
  id        String   @id @default(uuid())
  userId    String
  reviewId  String
  type      String   // "HELPFUL", "FUNNY", "👍", etc.
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id])
  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@unique([userId, reviewId, type])
}

model UserReadingStat {
  id           String   @id @default(uuid())
  userId       String
  date         DateTime @db.Date
  chaptersRead Int      @default(0)
  
  user User @relation(fields: [userId], references: [id])
  
  @@unique([userId, date])
}

enum LibraryStatus {
  READING
  COMPLETED
  ON_HOLD
  DROPPED
  PLAN_TO_READ
}

model LibraryEntry {
  userId     String
  comicId    String
  status     LibraryStatus
  score      Float?
  startedAt  DateTime?
  finishedAt DateTime?
  updatedAt  DateTime      @updatedAt
  
  user  User  @relation(fields: [userId], references: [id])
  comic Comic @relation(fields: [comicId], references: [id], onDelete: Cascade)
  
  @@id([userId, comicId])
}
